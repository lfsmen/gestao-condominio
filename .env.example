# Supabase (produção - opcional)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Postgres direct (Prisma)
# Docker local development:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/condominio?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/condominio?schema=public"
# Produção (Supabase):
# DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"
# DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=admin@condominio.app

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cron (gerar 32+ chars random)
CRON_SECRET=replace-with-32-byte-random-secret-please

# Auth (dev): se DEV_AUTH_USER for definido, magic-link/Supabase é desactivado
# e a sessão é simulada com este email.
DEV_AUTH_USER=
